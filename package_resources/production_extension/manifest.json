{
  "manifest_version": 3,
  "name": "MusicHook",
  "version": "0.1.2",
  "description": "Local CLI bridge for starting focused music in Zen.",
  "browser_specific_settings": {
    "gecko": {
      "id": "@music-hook.automatacrypt",
      "update_url": "https://cryoviking.github.io/MusicHook/updates.json",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "permissions": [
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://music.youtube.com/*",
    "https://www.youtube.com/*",
    "https://youtube.com/*"
  ],
  "content_scripts":[
    {
      "matches": [
        "https://music.youtube.com/*",
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js":[
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
